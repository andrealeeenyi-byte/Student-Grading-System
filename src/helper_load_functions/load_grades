# Load grades into a dictionary
def load_grades():
    """Load grades, converting marks to float when possible."""
    grades = []
    if not os.path.exists(GRADES_FILE):
        return grades

    with open(GRADES_FILE, "r") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue

            parts = [p.strip() for p in line.split(",")]
            if len(parts) < 4:
                continue

            # Parse marks - try float, fall back to string
            marks_str = parts[2]
            try:
                if "/" in marks_str:
                    # Handle "40/50" format
                    num, denom = marks_str.split("/")
                    marks_float = float(num) / float(denom) * 100
                else:
                    marks_float = float(marks_str)
                marks_display = marks_str  # Keep original for display
                marks_numeric = marks_float  # Keep numeric for calculations
            except (ValueError, ZeroDivisionError):
                marks_display = marks_str
                marks_numeric = 0.0

            record = {
                "student_id": parts[0],
                "course_id": parts[1],
                "marks_display": marks_display,  # Original string
                "marks_numeric": marks_numeric,  # Float for calculations
                "grade": parts[3]
            }

            if len(parts) >= 5:
                record["test_name"] = parts[4]

            grades.append(record)

    return grades