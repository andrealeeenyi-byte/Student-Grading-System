import os


# Load courses into a dictionary
def load_courses():

    courses = {}
    if not os.path.exists(COURSES_FILE):
        return courses

    with open(COURSES_FILE, "r") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            parts = [p.strip() for p in line.split(",")]
            if len(parts) < 2:
                continue
            cid, cname = parts[0], parts[1]
            courses[cid] = cname
    return courses