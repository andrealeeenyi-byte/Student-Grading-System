def save_grades(grades_list):
    with open(GRADES_FILE, "w") as f:
        for record in grades_list:
            test_name = record.get("test_name", "")

            # Use marks_display if available, otherwise fallback to original marks
            marks_to_save = record.get("marks_display", record.get("marks"))
            if marks_to_save is None:
                marks_to_save = ""
            f.write(f"{record['student_id']},{record['course_id']},{marks_to_save},{record['grade']},{test_name}\n")