import os


# Load students into a dictionary
def load_students():

    students = {}
    if not os.path.exists(STUDENTS_FILE):
        return students

    with open(STUDENTS_FILE, "r") as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            parts = [p.strip() for p in line.split(",")]
            if len(parts) < 3:
                continue
            sid, name, email = parts[0], parts[1], parts[2]
            students[sid] = {"name": name, "email": email}
    return students